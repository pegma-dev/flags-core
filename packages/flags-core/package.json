{
  "name": "@pegma/flags-core",
  "version": "0.1.1",
  "description": "Typed flag schema, evaluation client, and adapter conformance for Pegma hosts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/flags-core.git",
    "directory": "packages/flags-core"
  },
  "dependencies": {
    "@pegma/flags-contracts": "0.1.1",
    "@pegma/spine": "0.1.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -p tsconfig.json"
  }
}
