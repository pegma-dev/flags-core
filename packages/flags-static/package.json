{
  "name": "@pegma/flags-static",
  "version": "0.1.1",
  "description": "In-memory static flag provider for Pegma tests and local development.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pegma-dev/flags-core.git",
    "directory": "packages/flags-static"
  },
  "dependencies": {
    "@pegma/flags-contracts": "0.1.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "tsc -p tsconfig.json"
  }
}
